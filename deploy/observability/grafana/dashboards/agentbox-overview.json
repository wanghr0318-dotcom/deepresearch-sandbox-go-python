      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, kind) (rate(agentbox_attempt_ready_seconds_bucket[1m])))",
          "legendFormat": "p50 {{kind}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(agentbox_attempt_ready_seconds_bucket[1m])))",
          "legendFormat": "p95 {{kind}}"
