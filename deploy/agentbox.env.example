# agentbox server 配置示例：与 `agentbox server` 的环境变量和标志一一对应（README 快速开始按原样载入本文件）。
#   sudo sh -c 'set -a; . deploy/agentbox.env.example; exec ./bin/agentbox server $AGENTBOX_SERVER_FLAGS'
#   set -a; . deploy/agentbox.env.example; set +a        # 之后 agentbox task …、status 读取 AGENTBOX_ADDR
# 复制为自己的文件后按需修改。server 必须以 root 运行（cgroup、命名空间与 UID 映射）。

# PostgreSQL（与 deploy/docker-compose.yml 一致）。server 与 verify-invariants 未给 --database-url 时读取它。
AGENTBOX_DATABASE_URL='postgres://agentbox:agentbox@127.0.0.1:5432/agentbox?sslmode=disable'

# CLI（agentbox task …、agentbox status）连接的服务地址；与下面的 --listen 一致。
AGENTBOX_ADDR='http://127.0.0.1:8080'

# Gateway 供应商 Key：只从宿主环境变量读取（没有对应的标志），只交给 Gateway 的上游 adapter，不写日志、
# 不进入 Worker 的 init 与沙箱环境变量。需要时在自己的副本中取消注释并填写（本示例不调用付费上游）：
#   AGENTBOX_MODEL_API_KEY=''     # --model-base-url 指向的 OpenAI 兼容模型上游
#   AGENTBOX_SEARCH_API_KEY=''    # --search-provider tavily 或 serper 时必填（所选供应商的 Key，server 只读这一个）

# scripts/demo-m2.sh（真实研究演示）读取的变量（只列变量名；Key 不写进本文件，演示脚本从环境变量或仓库根的
# git-ignored .env 中只读取 AGENTBOX_MODEL_API_KEY 与所选搜索供应商的 Key 行：tavily 读 AGENTBOX_SEARCH_API_KEY，
# serper 读 AGENTBOX_SERPER_API_KEY 并作为 AGENTBOX_SEARCH_API_KEY 交给 server，两种 Key 可并存于 .env）：
#   AGENTBOX_DEMO_MODEL_BASE_URL='https://api.moonshot.cn/v1'  # → --model-base-url（OpenAI 兼容端点；默认 Moonshot）
#   AGENTBOX_DEMO_ORCHESTRATOR_MODEL='kimi-k3' # 编排模型：计划与报告（任务 config.orchestrator_model）
#   AGENTBOX_DEMO_WORKER_MODEL='kimi-k2.6'     # worker 模型：任务内总结（config.worker_model；也是 --model-name）
#   AGENTBOX_DEMO_MODELS='kimi-k2.6,kimi-k2.7-code,kimi-k2.7-code-highspeed,kimi-k3'  # → --models
#   AGENTBOX_DEMO_SEARCH_PROVIDER='ddg_lite'  # → --search-provider（ddg_lite | tavily | serper）
#   AGENTBOX_DEMO_TOPIC=''                    # 研究题目（空时用脚本内的默认中文题目）
#   AGENTBOX_DEMO_PRICE_IN_MICRO_PER_MTOK=''  # → --model-price-in-micro-per-mtok（可选）
#   AGENTBOX_DEMO_PRICE_OUT_MICRO_PER_MTOK='' # → --model-price-out-micro-per-mtok（可选）
#   AGENTBOX_DEMO_MODEL_PRICES=''             # → --model-price（可选，model=IN:OUT，逗号分隔）
#   AGENTBOX_DEMO_BUDGET_MICRO=''             # 任务的 limits.budget_micro（可选）
#   AGENTBOX_DEMO_ENV_FILE=''                 # Key 文件（默认 <仓库根>/.env）
#   AGENTBOX_DEMO_FAKE=1                      # 演练：fake upstream 代替模型与搜索，不访问外网
#   AGENTBOX_DEMO_WEB_DIR=''                  # → --web-dir（可选；demo-m1.sh 与 demo-m2.sh 都支持）

# server 标志（值为默认值，--data-dir 除外，它没有默认值）：
#   --data-dir              数据目录（必填；server 以 0711 建立，任务 workspace 在其下，Gateway socket 在 <data>/gateway）
#   --listen                API 监听地址；非 loopback 需要 <data>/api.token 与 --allowed-host
#   --cgroup-root           cgroup v2 挂载点
#   --run-slots             并发执行的任务数
#   --memory-bytes          全部任务环境的内存总量（字节）
#   --default-memory-bytes  limits 未设置 memory_max 时每个任务的内存（字节）
#   --default-run-time      未指定 limits.max_run_time_ms 的任务的累计运行时限
#   --run-time-cap          显式累计运行时限的上限
#   --worker-argv           沙箱内启动 Worker 的命令（逗号分隔）
#   --worker-env            沙箱内 Worker 的环境变量（逗号分隔；键须在白名单中，如 PYTHONPATH；worker 包安装在 /opt/agentbox）
#   --allowed-host          非 loopback 监听时 Host 头的允许值（逗号分隔；默认空，本示例不用）
#   --allowed-origin        浏览器 Origin 的允许值（逗号分隔，不允许通配；默认 <scheme>://监听地址 与每个允许的 Host）
#   --web-dir               同源提供的工作台静态文件目录（例如 <仓库>/web/dist，由 cd web && npm ci && npm run build 生成；
#                           默认空 = 不提供工作台）
#   --redis-addr            共享缓存的 Redis 地址（例如 127.0.0.1:6379；默认空 = 缓存关闭；Redis 只监听本机）
#   --cache                 on|off（默认 on；未设置 --redis-addr 时等价于 off）。签名密钥 <data>/cache.key 自动生成，
#                           轮换：停止 server 后 agentbox cache rotate-key，再启动
#   --tls-cert / --tls-key  内置 TLS 的证书与私钥（PEM，须同时设置；默认空）；非 loopback 监听且未设置时启动警告
#   --default-budget-micro  未指定 limits.budget_micro 的任务的 task 层预算（微美元；2000000 = 2.00 USD）
#   --budget-cap-micro      显式 limits.budget_micro 的上限（微美元）
#   --model-base-url        OpenAI 兼容模型上游地址（默认空：不提供 /v1/chat/completions，本示例不用）
#   --model-name            默认模型名：请求未指定 model 时使用（配置了 --model-base-url 时必填）
#   --models                声明的模型白名单（逗号分隔，须包含 --model-name；默认空 = 只有 --model-name）；
#                           请求可在其中选择 model，白名单外为 400 unsupported_model
#   --model-price-in-micro-per-mtok   默认模型输入单价（每百万 token 的微美元；默认 3000000）
#   --model-price-out-micro-per-mtok  默认模型输出单价（每百万 token 的微美元；默认 15000000）
#   --model-price           按模型的单价 model=IN:OUT（可重复或逗号分隔；模型须已声明；未给出的模型用上面两项）。
#                           单价只是配置，用于预留估算与结算，不代表供应商的实际计费
#   Moonshot（OpenAI 兼容）示例：--model-base-url https://api.moonshot.cn/v1 --model-name kimi-k2.6
#     --models kimi-k2.6,kimi-k2.7-code,kimi-k2.7-code-highspeed,kimi-k3（Key 放在 AGENTBOX_MODEL_API_KEY，不写进本文件）
#   用户账号：配置了 --model-base-url 时启用（/auth/register、/auth/login 与 POST /research；需要 <data>/api.token
#     才有运维权限）。用户只提交主题，研究 spec 的模型由下面两项固定，两者都须在 --model-name / --models 中，
#     否则拒绝启动（退出码 2）。用户管理：agentbox user list | disable <name> | enable <name>（直接连库，
#     --database-url 默认取 AGENTBOX_DATABASE_URL；停用即吊销其全部会话）
#   --user-orchestrator-model  用户研究的编排模型（spec.orchestrator_model；默认 kimi-k3）
#   --user-worker-model        用户研究的 worker 模型（spec.worker_model；默认 kimi-k2.6）
#   --search-provider       搜索供应商：ddg_lite（默认，解析 DuckDuckGo Lite 页面，仅演示）| tavily（需要 Key）
#                           | serper（Google 结果，经 Serper.dev；需要 Key）| fake（只用于测试，须同时设置 --upstream-allow-private）
#   --upstream-allow-private  显式放行的私有上游主机（逗号分隔的 host 或 host:port；默认空，本示例不用）
#   --call-deadline         搜索与抓取（/v1/search、/v1/fetch）的调用期限（默认 2m0s = 120 s；须 > 0）；自首次登记起计，
#                           含等待槽位、退避与全部 try，Worker 重连与 server 重启都不重置
#   --model-call-deadline   模型调用（/v1/chat/completions）的调用期限（默认 5m0s = 300 s；须 > 0）。推理模型生成长报告
#                           （max_tokens 达 16384）可能超过 120 s。Worker 客户端的等待（默认 330 s）须长于两个期限：
#                           期限调到 330 s 及以上时在 --worker-env 中加 AGENTBOX_GATEWAY_TIMEOUT_S=<更长的秒数>
AGENTBOX_SERVER_FLAGS='--data-dir /var/lib/agentbox --listen 127.0.0.1:8080 --cgroup-root /sys/fs/cgroup --run-slots 4 --memory-bytes 8589934592 --default-memory-bytes 1073741824 --default-run-time 1h --run-time-cap 24h --worker-argv python3,-m,sim_worker --worker-env PYTHONPATH=/opt/agentbox --default-budget-micro 2000000 --budget-cap-micro 50000000 --search-provider ddg_lite'
