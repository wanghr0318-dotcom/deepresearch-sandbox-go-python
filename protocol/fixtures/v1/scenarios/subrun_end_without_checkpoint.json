{
  "name": "subrun_end_without_checkpoint",
  "description": "subrun_end{succeeded} 只是提议：之后没有任何已提交 checkpoint 列出 completed 就直接 result，事件流合法，但该 sub-run 不是 completed（成功裁决时仍非终态 → failed/not_completed_at_result；result.subruns 只供展示）",
  "layers": ["protocol"],
  "lines": [
    {"from": "host", "message": {"type": "init", "bootstrap": 1, "protocol_versions": [1], "mode": "task", "task_id": "t-1", "attempt_id": "a-1", "attempt_no": 1, "out_dir": "/workspace/out/a-1", "extensions": ["subruns"]}},
    {"from": "worker", "message": {"type": "ready", "v": 1, "seq": 1, "protocol_version": 1, "mode": "task", "worker": {"name": "research-worker", "version": "0.1.0"}, "capabilities": [], "subruns": 1}},
    {"from": "worker", "message": {"type": "subrun_start", "v": 1, "seq": 2, "subrun_id": "st1", "parent_step_id": "research", "deadline_ms": 600000}},
    {"from": "host", "message": {"type": "subrun_started", "v": 1, "subrun_id": "st1", "status": "started"}},
    {"from": "worker", "message": {"type": "progress", "v": 1, "seq": 3, "step_id": "research", "kind": "tool_call", "message": "web_search", "subrun_id": "st1"}},
    {"from": "worker", "message": {"type": "subrun_end", "v": 1, "seq": 4, "subrun_id": "st1", "status": "succeeded", "summary": "找到 3 个来源"}},
    {"from": "worker", "message": {"type": "result", "v": 1, "seq": 5, "summary": "完成", "outputs": [], "subruns": [{"id": "st1", "status": "completed", "summary": "找到 3 个来源"}]}}
  ],
  "expect": {"stream": "ok", "subruns": {"st1": "failed"}}
}
