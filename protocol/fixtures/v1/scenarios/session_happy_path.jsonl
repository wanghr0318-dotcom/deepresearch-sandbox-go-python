{"from": "worker", "message": {"type": "task_accepted", "v": 1, "seq": 2, "attempt_id": "a-1"}}
{"from": "worker", "message": {"type": "checkpoint", "v": 1, "seq": 3, "attempt_id": "a-0", "checkpoint_id": "cp-1", "scope": "task", "step_id": "s1", "state": {}}}
