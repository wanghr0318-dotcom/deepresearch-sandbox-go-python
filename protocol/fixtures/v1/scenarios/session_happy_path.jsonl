{"from": "host", "message": {"type": "init", "bootstrap": 1, "protocol_versions": [1], "mode": "session", "session_id": "s-1", "incarnation_id": "inc-1"}}
{"from": "worker", "message": {"type": "ready", "v": 1, "seq": 1, "protocol_version": 1, "mode": "session", "session_ext": 1, "worker": {"name": "chatagent", "version": "0.1.0"}, "capabilities": []}}
{"from": "host", "message": {"type": "task_start", "v": 1, "task_id": "t-1", "attempt_id": "a-1", "attempt_no": 1, "out_dir": "/workspace/out/a-1"}}
{"from": "worker", "message": {"type": "progress", "v": 1, "seq": 2, "attempt_id": "a-1", "kind": "step_started", "message": "开始"}}
{"scenario": "task_start_while_active", "description": "宿主在 attempt 运行中再发 task_start", "expect": {"stream": "violation", "violation": "not_idle", "at": 4}}
